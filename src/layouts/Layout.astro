---
// Palette only -- site-wide. Page CSS is imported per page: the v2 pages
// pull src/styles/redesign.css, the blog pulls src/styles/global.css. Both
// read their colours from these tokens, so the two never have to agree on
// anything but the variable names.
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  canonicalUrl?: string;
  isHome?: boolean;
  ogType?: "website" | "article";
  alternates?: { hreflang: string; href: string }[];
  lang?: "en" | "th";
}

const {
  title = "Vitchakorn Poonyakanok | Physician & Clinical AI",
  description = "Vitchakorn (Blue) Poonyakanok is a physician and clinical data analyst building clinical AI, travel medicine, and public health data systems.",
  keywords = "Vitchakorn Poonyakanok, Blue Poonyakanok, physician, clinical AI, travel medicine, public health data, medical informatics, clinical data analyst, health care analytics",
  image = "https://vitchakorn.com/pic/og-card.jpg",
  imageWidth = 1200,
  imageHeight = 1200,
  imageAlt = "Vitchakorn Poonyakanok — physician bridging travel medicine, public health, data analysis, and AI engineering into intelligent health systems.",
  canonicalUrl = "https://vitchakorn.com/",
  isHome = false,
  // Listing/index pages (e.g. the blog index) are neither the homepage nor
  // a single article -- let callers override the isHome-derived default
  // instead of getting mislabeled as "article".
  ogType = isHome ? "website" : "article",
  alternates,
  // Drives <html lang>. BlogPost sets lang="th" on the content div, but the
  // <title>, <h1>, description and tags all sit outside it, so without this
  // a Thai post's headline is announced by an English TTS voice.
  lang = "en",
} = Astro.props;

// og:image/twitter:image must be absolute URLs per spec — pages pass a
// site-root-relative path (e.g. a per-post heroImage), so resolve it here.
const absoluteImage = image.startsWith('http') ? image : `https://vitchakorn.com${image}`;
---

<!DOCTYPE html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Vitchakorn Poonyakanok">
  <meta name="keywords" content={keywords}>
  <meta name="google-site-verification" content="ggpyNV2PPWEqnqU-NbSOp23tEzoVmyP40YXX4Mz0ves">
  <link rel="canonical" href={canonicalUrl}>
  {alternates?.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="Vitchakorn Poonyakanok">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={absoluteImage}>
  <meta property="og:image:width" content={String(imageWidth)}>
  <meta property="og:image:height" content={String(imageHeight)}>
  <meta property="og:image:alt" content={imageAlt}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalUrl}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImage}>
  <meta name="twitter:image:alt" content={imageAlt}>
  
  {isHome && (
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://vitchakorn.com/#website",
          "url": "https://vitchakorn.com/",
          "name": "Vitchakorn Poonyakanok",
          "description": "Portfolio of Vitchakorn Poonyakanok, a physician and clinical data analyst working on clinical AI, travel medicine tools, and public health data systems.",
          "inLanguage": "en"
        },
        {
          "@type": "Person",
          "@id": "https://vitchakorn.com/#person",
          "name": "Vitchakorn Poonyakanok",
          "alternateName": "Blue Poonyakanok",
          "url": "https://vitchakorn.com/",
          "image": "https://vitchakorn.com/pic/vitchakorn.jpg",
          "email": "mailto:vk.poonyakanok@gmail.com",
          "jobTitle": [
            "Physician",
            "Travel Medicine Physician",
            "Clinical Data Analyst"
          ],
          "homeLocation": {
            "@type": "Place",
            "name": "Pittsburgh, Pennsylvania, United States"
          },
          "affiliation": {
            "@type": "CollegeOrUniversity",
            "name": "Carnegie Mellon University, Heinz College of Information Systems and Public Policy",
            "url": "https://www.heinz.cmu.edu/"
          },
          "alumniOf": [
            {
              "@type": "CollegeOrUniversity",
              "name": "Mahidol University"
            },
            {
              "@type": "CollegeOrUniversity",
              "name": "Chulalongkorn University"
            },
            {
              "@type": "EducationalOrganization",
              "name": "Institute of Preventive Medicine, Department of Disease Control, Ministry of Public Health"
            }
          ],
          "knowsAbout": [
            "Clinical AI",
            "Travel Medicine",
            "Public Health Data",
            "Medical Informatics",
            "Clinical Decision Support",
            "Health Care Analytics"
          ],
          "sameAs": [
            "https://www.linkedin.com/in/vitchakorn",
            "https://scholar.google.com/citations?user=r9uxNqQAAAAJ&hl=en",
            "https://www.researchgate.net/profile/Vitchakorn-Poonyakanok",
            "https://orcid.org/0009-0007-9945-0376",
            "https://github.com/vpoonyak",
            "https://huggingface.co/vpoonyak",
            "https://g.dev/vitchakorn",
            "https://www.kaggle.com/vitchakorn",
            "https://public.tableau.com/app/profile/vitchakorn.poonyakanok"
          ]
        }
      ]
    }
    </script>
  )}

  <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon/favicon-32x32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/favicon/favicon-16x16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
  <noscript><style>.fade-in{opacity:1;transform:none;}</style></noscript>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={isHome
    ? 'https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@1,500;1,600&display=swap'
    : 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap'} rel="stylesheet">
  
  <!-- Blocking on purpose: stamps the theme on <html> before first paint so
       the page never repaints. An explicit choice (localStorage) wins;
       otherwise follow the OS, using light when no dark preference is set. -->
  <script is:inline>
    (function () {
      var theme;
      try { theme = localStorage.getItem('theme'); } catch (e) { /* storage blocked */ }
      if (theme !== 'light' && theme !== 'dark') {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <slot />

  <!-- Global Client Side scripts -->
  <script>
    // Theme toggle runtime event registration
    const htmlEl = document.documentElement;
    const bodyEl = document.body;
    const themeToggle = document.getElementById('themeToggle');

    // Make sure body attribute matches document element immediately
    const currentTheme = htmlEl.getAttribute('data-theme') || 'dark';
    bodyEl.setAttribute('data-theme', currentTheme);

    function applyTheme(next) {
      htmlEl.setAttribute('data-theme', next);
      bodyEl.setAttribute('data-theme', next);
      const frame = document.getElementById('roles3d') as HTMLIFrameElement | null;
      try {
        const sceneWindow = frame?.contentWindow as (Window & { setPortfolioTheme?: (mode: string) => void }) | null;
        sceneWindow?.setPortfolioTheme?.(next);
      } catch { /* A frame that is still loading receives the theme on load. */ }
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let requestedTheme = currentTheme;
    let themeRevision = 0;
    let activeThemeTransition: { skipTransition: () => void } | null = null;
    function changeTheme(next: string) {
      requestedTheme = next;
      const revision = ++themeRevision;
      activeThemeTransition?.skipTransition();
      htmlEl.setAttribute('data-theme-switching', '');
      const commit = () => { if (revision === themeRevision) applyTheme(next); };
      const finish = () => {
        if (revision !== themeRevision) return;
        htmlEl.removeAttribute('data-theme-switching');
        activeThemeTransition = null;
      };
      if (reducedMotion.matches || !document.startViewTransition) {
        commit();
        // Keep individual component transitions disabled through the paint.
        requestAnimationFrame(() => requestAnimationFrame(finish));
        return;
      }
      const transition = document.startViewTransition(commit);
      activeThemeTransition = transition;
      transition.ready.catch(() => { /* Rapid toggles may skip the older snapshot. */ });
      transition.finished.then(finish, finish);
    }

    if (themeToggle) {
      themeToggle.addEventListener('click', function() {
        const next = requestedTheme === 'dark' ? 'light' : 'dark';
        changeTheme(next);
        // Clicking the toggle is an explicit choice: from here on it wins
        // over the OS setting on this device.
        try { localStorage.setItem('theme', next); } catch (e) { /* storage blocked */ }
      });
    }

    // Follow the OS if the visitor has never used the toggle, so the page
    // tracks a system light/dark switch while they're on it.
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch (err) { /* storage blocked */ }
      if (saved === 'light' || saved === 'dark') return;
      changeTheme(e.matches ? 'dark' : 'light');
    });
  </script>
</body>
</html>
