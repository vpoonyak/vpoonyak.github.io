---
// Icons are self-hosted under /logo/si/ (mirrored from Simple Icons)
// rather than fetched per-badge from cdn.simpleicons.org -- that was 23
// cross-origin requests on the critical path for decorative 15px marks.
//
// Skill rows mirror the `skills` block in ~/Github/cv/profile/profile.yaml.
// Deliberately absent: React/Vite/TypeScript/Tailwind and the other
// AI-assisted-dev-only entries the profile flags as "present in the shipped
// products, not personal competencies".
const stacks = [
  {
    title: 'Core',
    items: [
      // The official two-tone mark (blue + yellow snakes), not Simple
      // Icons' single-colour silhouette. The yellow snake is weak on the
      // light card (1.6:1) but this is a genuine two-colour brand identity
      // where inverting one snake would break the other -- same "accepted
      // as-is" precedent as Matplotlib/Power BI/LightGBM above.
      { label: 'Python', img: '/logo/Python-logo.svg' },
      // The official oval-ring mark (gray ring + blue R), not Simple Icons'
      // single-colour letterform silhouette.
      { label: 'R', img: '/logo/R-logo.svg' },
      // The official elephant artwork (brand blue #336791), not Simple
      // Icons' flattened silhouette. Kept close to the standard 15px badge
      // size per user preference (18px) rather than the larger sizes
      // (24-40px) that read more crisply but made the pill visibly taller
      // than its row-mates.
      { label: 'SQL', img: '/logo/PostgreSQL-elephant.svg', size: 18 },
      // Stata's own favicon is a native 16x16 .ico (no larger source
      // exists on stata.com), so it renders near 1:1 at this badge size
      // rather than being upscaled/blurred.
      { label: 'Stata', img: '/logo/Stata-icon.png' },
      { label: 'Pandas', icon: '/logo/si/pandas.svg', darkFlip: true },
      { label: 'NumPy', icon: '/logo/si/numpy.svg', darkFlip: true },
    ],
  },
  {
    title: 'ML &amp; AI',
    items: [
      { label: 'PyTorch', icon: '/logo/si/pytorch.svg' },
      { label: 'TensorFlow', icon: '/logo/si/tensorflow.svg' },
      { label: 'Scikit-Learn', icon: '/logo/si/scikitlearn.svg' },
      { label: 'XGBoost' },
      // LightGBM: cut to just the 4-colour lightning-bolt mark, dropping the
      // "LightGBM" text portion of the source wordmark.
      { label: 'LightGBM', icon: '/logo/LightGBM-icon.svg' },
      { label: 'YOLO', icon: '/logo/si/ultralytics.svg', darkFlip: true },
      { label: 'OpenCV', icon: '/logo/si/opencv.svg' },
    ],
  },
  {
    title: 'LLM APIs',
    items: [
      // OpenAI's file is misleadingly named and xAI's carries no fill at
      // all: both render black, so they take the dark-canvas flip, not the
      // light-canvas one. ThaiLLM's really is fill="white".
      { label: 'GPT', img: '/logo/OpenAI-logo-white.svg', themeInvert: true },
      { label: 'Claude', icon: '/logo/si/claude.svg' },
      { label: 'Gemini', icon: '/logo/si/googlegemini.svg' },
      { label: 'GLM', img: '/logo/Z.ai-logo.svg' },
      { label: 'Grok', img: '/logo/xAI-logo.svg', themeInvert: true },
      { label: 'Qwen', icon: '/logo/si/qwen.svg' },
      { label: 'ThaiLLM', img: '/logo/ThaiLLM-logo-white.svg', lightInvert: true },
      { label: 'Typhoon', img: '/logo/Typhoon-icon.png' },
      // THaLLE's only mark is a wordmark, not a square icon -- cropped from
      // the user-supplied KBTG asset (dropping the "by KBTG" subline, which
      // is illegible at badge scale and a second color that fails on the
      // opposite theme from the teal). The teal is bright enough to vanish
      // on the light/cream canvas the same way Linux's yellow does, so it
      // takes the same lightFlip treatment; `wide` widens its box so the
      // ~5:1 aspect wordmark isn't squeezed into a 15px square.
      { label: 'THaLLE', icon: '/logo/THaLLE-logo.png', lightFlip: true, wide: 56 },
    ],
  },
  {
    title: 'Visualization',
    items: [
      { label: 'Tableau', img: '/favicon/tableau.png' },
      { label: 'Power BI', img: '/logo/Power-BI.svg' },
      { label: 'Matplotlib', img: '/logo/Matplotlib-logo.svg' },
      { label: 'Seaborn', img: '/logo/Seaborn-logo.svg' },
      { label: 'Looker', icon: '/logo/si/looker.svg' },
      { label: 'QGIS', icon: '/logo/si/qgis.svg' },
    ],
  },
  {
    title: 'Cloud &amp; Security',
    items: [
      { label: 'Google Cloud', icon: '/logo/si/googlecloud.svg' },
      // The real 3-tone flame (yellow/orange/red-orange) cropped from the
      // user-supplied full wordmark, not Simple Icons' single-colour
      // silhouette. Yellow/orange are weak on the light card (1.6/2.26)
      // but the dominant red-orange shape holds up on both -- same
      // "accepted as-is" multi-colour precedent as Python/LightGBM.
      { label: 'Firebase', img: '/logo/Firebase-flame.svg' },
      { label: 'Huawei Cloud', icon: '/logo/si/huawei.svg' },
      { label: 'ISC2 CC', icon: '/logo/si/isc2.svg' },
      { label: 'Git', icon: '/logo/si/git.svg' },
    ],
  },
  {
    title: 'Computing',
    items: [
      // LANTA (the machine) has no standalone mark of its own -- only a
      // promotional banner photo, not a usable icon -- so this shows
      // ThaiSC's logo (the NSTDA center that operates it), same
      // product-vs-operating-org relationship as Grok/xAI and GLM/Z.ai
      // above. Cropped from thaisc.io's white wordmark; the "NSTDA
      // Supercomputer Center" subline is dropped, illegible at badge scale.
      { label: 'LANTA HPC', img: '/logo/ThaiSC-logo-white.png', lightInvert: true, wide: 40 },
      { label: 'Linux', icon: '/logo/si/linux.svg', lightFlip: true },
      { label: 'Anaconda', icon: '/logo/si/anaconda.svg' },
      { label: 'Jupyter', icon: '/logo/si/jupyter.svg' },
      { label: 'Arduino', icon: '/logo/si/arduino.svg' },
      { label: 'vLLM', icon: '/logo/si/vllm.svg' },
    ],
  },
];

const credentials = [
  {
    href: 'https://www.credly.com/badges/8769d712-3992-4f5c-b8bc-af7ba2b1f15c/',
    img: '/badge/certified-in-cybersecurity-cc.1-white.png',
    name: 'ISC2 Certified in Cybersecurity',
    meta: 'Apr 2026 – Mar 2029 · ISC2',
  },
  {
    href: 'https://mysuperai.aiat.or.th/verify/3893dd94-0ff5-464f-b26f-f8f44e655bdf',
    img: '/experience/superai.webp',
    name: 'AI Practitioner',
    meta: 'Jun 2026 · Super AI Engineer S6, AIAT',
  },
  {
    href: 'https://vitchakorn.com/cert/HWENDCTEDA695219.png',
    img: '/certlogo/HCCDA.png',
    name: 'Huawei Cloud HCCDA ×2',
    meta: 'Apr 2026 – Apr 2029 · Tech + AI',
  },
  {
    href: 'https://www.coursera.org/account/accomplishments/specialization/WPWVMVL82V42',
    img: '/badge/google-advanced-data-analytics-certificate.webp',
    name: 'Google Advanced Data Analytics',
    meta: 'Sep 2023 · Google · Coursera',
  },
];
---

<section class="rd-section" id="skills">
  <div class="rd-section-head">
    <div class="rd-section-num">06</div>
    <h2 class="rd-section-kicker">Capabilities</h2>
    <a href="/credentials/" class="rd-btn rd-section-action">Full credential archive</a>
  </div>

  <div class="rd-body">
    <p class="rd-mobile-only">Core tools: Python, R, SQL and Stata.</p>
    <details class="rd-mobile-details" data-mobile-detail open>
    <summary>Explore tools and technologies</summary>
    <div class="rd-stack-grid">
      {stacks.map((group) => (
        <div>
          <div class="rd-col-label" style="margin-bottom:12px" set:html={group.title} />
          <div class="rd-badges">
            {group.items.map((item) => (
              <span class="rd-badge">
                {item.icon && <img src={item.icon} alt="" width="15" height="15" loading="lazy" style={item.wide ? `width:${item.wide}px` : item.size ? `width:${item.size}px;height:${item.size}px` : undefined} data-dark-flip={item.darkFlip ? '1' : undefined} data-light-flip={item.lightFlip ? '1' : undefined}>}
                {item.img && <img src={item.img} alt="" width="15" height="15" loading="lazy" style={item.wide ? `width:${item.wide}px` : item.size ? `width:${item.size}px;height:${item.size}px` : undefined} data-light-invert={item.lightInvert ? '1' : undefined} data-theme-invert={item.themeInvert ? '1' : undefined}>}
                {item.label}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
    </details>

    <div class="rd-block">
      <div class="rd-col-label" style="margin-bottom:12px">Top credentials</div>
      <div class="rd-cred-list">
        {credentials.map((c) => (
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="rd-cred">
            <img src={c.img} alt="" width="36" height="36" loading="lazy">
            <span>
              <span class="rd-cred-name">{c.name}</span>
              <span class="rd-cred-meta">{c.meta}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="rd-block">
      <div class="rd-col-label" style="margin-bottom:12px">Languages</div>
      <div class="rd-badges">
        <span class="rd-badge">Thai: Native</span>
        <span class="rd-badge">
          <img src="/logo/toefl-logo.svg" alt="" class="toefl" width="34" height="15" loading="lazy" data-theme-invert="1">
          TOEFL iBT: 91/120
        </span>
        <span class="rd-badge">
          <img src="/logo/duolingo.svg" alt="" width="15" height="15" loading="lazy">
          Duolingo English Test: 120/160
        </span>
      </div>
    </div>
  </div>
</section>
