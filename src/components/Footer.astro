---
const year = new Date().getFullYear();
---

<footer class="rd-footer">
  <span>© {year} VITCHAKORN POONYAKANOK</span>
  <span>PITTSBURGH, PA · <span id="localTime">--:--</span> <span id="localTimeZone">ET</span></span>
  <span class="rd-footer-links">
    <a href="/project/">ARCHIVE</a>
    <a href="/blog">BLOG</a>
    <a href="/#top">TOP</a>
  </span>
</footer>

<style>
  .rd-footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    background: var(--bg);
  }
  .rd-footer > * {
    padding: 20px clamp(20px, 4vw, 28px);
    border-right: 1px solid var(--rule);
  }
  .rd-footer > *:last-child { border-right: none; }
  .rd-footer-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .rd-footer a { color: inherit; text-decoration: none; }
  .rd-footer a:hover { color: var(--accent); }

  /* Below 460px the auto-fit grid can only fit one 220px column, so the three
     cells stack. Two things go wrong there: each cell keeps its border-RIGHT,
     which stacked draws a stray 1px tick down the right edge instead of a rule
     between rows; and three cells at 20px padding cost 167px — a fifth of a
     phone screen for a copyright line, a clock and three links. Divide the
     rows properly and tighten the padding. */
  @media (max-width: 460px) {
    .rd-footer > * {
      padding: 13px clamp(20px, 4vw, 28px);
      border-right: none;
      border-bottom: 1px solid var(--rule);
    }
    .rd-footer > *:last-child { border-bottom: none; }
  }
</style>

<script>
  // Local clock for Pittsburgh. The zone label is derived rather than
  // hardcoded so it reads EST in winter and EDT over daylight saving.
  const timeEl = document.getElementById('localTime');
  const zoneEl = document.getElementById('localTimeZone');
  if (timeEl) {
    const timeFmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'America/New_York',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const zoneFmt = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      timeZoneName: 'short',
    });
    function tick() {
      const now = new Date();
      timeEl.textContent = timeFmt.format(now);
      if (zoneEl) {
        const part = zoneFmt.formatToParts(now).find((p) => p.type === 'timeZoneName');
        if (part) zoneEl.textContent = part.value;
      }
    }
    tick();
    setInterval(tick, 30_000);
  }
</script>
