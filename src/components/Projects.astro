---
// Top eight of the thirteen case studies under public/project/. Slugs, thumbs
// and hrefs must stay in sync with public/project/index.html (the archive
// listing) and the customPages list in astro.config.mjs.
const projects = [
  {
    slug: 'ddschatbot',
    kicker: 'P.01 · PUBLIC HEALTH LLM',
    title: 'DDS Chatbot',
    thumb: '/project/ddschatbot/ddschatbot-thumb.webp',
    alt: 'DDS Chatbot: Thai disease-surveillance assistant',
    desc: 'Guardrailed Thai disease-surveillance assistant for DDC with tool-calling over a PII-free data mart. A 753-turn authorized red-team cut attack success from ~25% to ~1% in-session; 99.8% pass on a 3,819-run regression benchmark.',
  },
  {
    slug: 'altit',
    kicker: 'P.02 · CLINICAL DECISION SUPPORT',
    title: 'Altitude Analyzer',
    thumb: '/project/altit/altit1-thumb.webp',
    alt: 'Altitude Itinerary Analyzer',
    desc: 'AI itinerary extraction and high-altitude risk assessment for travel medicine clinics. 84.9% altitude accuracy within ±100 m on text itineraries; 2nd Place, BRIDGE-AI Summit 2026.',
  },
  {
    slug: 'yfmalaria',
    kicker: 'P.03 · CLINICAL DASHBOARD',
    title: 'YF &amp; Malaria Map',
    thumb: '/project/yfmalaria/yfmalaria-thumb.webp',
    alt: 'Yellow fever and malaria prevention dashboard',
    desc: "Country-clickable CDC Yellow Book guidance with multi-country trip planning.",
  },
  {
    slug: 'hospcode',
    kicker: 'P.04 · HEALTH DATA TOOL',
    title: 'Thai HospSearch',
    thumb: '/project/hospcode/hospcode-thumb.webp',
    alt: 'Thai HospSearch facility-code navigator',
    desc: "Facility-code navigator over ~174K MOPH-coded records across Thailand's 13 health regions, 77 provinces and 7,436 subdistricts. Runs in the browser with SQLite.",
  },
  {
    slug: 'group-testing',
    kicker: 'P.05 · MATH EXPLAINER VIDEO',
    title: 'Group Testing Explainer',
    thumb: '/project/group-testing/group-testing-thumb.webp',
    alt: 'Group testing explainer video: pooled sample tubes',
    desc: 'A 3Blue1Brown-style Manim explainer on pooled testing: expected-value optimization, a recursive re-splitting idea toward the information limit, and Dorfman’s 1943 origins.',
  },
  {
    slug: 'cirrhosis',
    kicker: 'P.06 · MACHINE LEARNING',
    title: 'Cirrhosis Survival',
    thumb: '/project/cirrhosis/cirrhosis-thumb.webp',
    alt: 'Cirrhosis survival prediction notebook',
    desc: 'Multi-class ensemble prediction (XGBoost/LightGBM) with engineered clinical features.',
  },
  {
    slug: 'hajjmens',
    kicker: 'P.07 · CLINICAL PLANNING TOOL',
    title: 'Hajj Menstrual Delay Planner',
    thumb: '/project/hajjmens/hajjmens-thumb.webp',
    alt: 'Hajj menstrual delay planner calendar view',
    desc: 'Counseling tool overlaying predicted cycles, Hajj ritual days and medication lead time on one Hijri/Gregorian calendar. Runs entirely in the browser; health data stays on the device.',
  },
  {
    slug: 'cda2558',
    kicker: 'P.08 · LEGAL REFERENCE',
    title: 'CDA 2558 App',
    thumb: '/project/cda2558/cda2558-thumb.webp',
    alt: "Communicable Disease Act B.E. 2558 interactive reader",
    desc: "Searchable reader for Thailand's Communicable Disease Act B.E. 2558, with Thai and Arabic numerals interchangeable so a section reference resolves either way. Unofficial, educational.",
  },
];
---

<section class="rd-work" id="projects">
  <div class="rd-section-head">
    <div class="rd-section-num">03</div>
    <h2 class="rd-section-kicker" id="projects-heading">Projects</h2>
    <a href="/project/" class="rd-btn rd-section-action">Full project archive / 13</a>
  </div>

  <div class="rd-work-carousel" role="region" aria-roledescription="carousel" aria-labelledby="projects-heading">
    <div class="rd-work-track" id="project-slides" tabindex="0" aria-label="Featured projects">
      {projects.map((p, i) => (
        <article class="rd-work-card" id={`featured-${p.slug}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${projects.length}`}>
          <a class="rd-work-media" href={`/project/${p.slug}/`} aria-label={`View ${p.alt}`} draggable="false">
            <img src={i < 5 ? `/project/${p.slug}/${p.slug}-highlight-poster.jpg` : p.thumb} alt={p.alt} width="600" height="400" loading="lazy" draggable="false">
            {i < 5 && <video muted playsinline preload="none" data-src={`/project/${p.slug}/${p.slug}-highlight.mp4`} poster={`/project/${p.slug}/${p.slug}-highlight-poster.jpg`} aria-hidden="true" tabindex="-1" disablepictureinpicture />}
          </a>
          <a class="rd-work-copy" href={`/project/${p.slug}/`} draggable="false">
            <div class="rd-work-meta"><span>{p.kicker}</span></div>
            <h3 class="rd-work-title" set:html={p.title} />
            <p class="rd-work-desc">{p.desc}</p>
            <span class="rd-work-action">View case study</span>
          </a>
        </article>
      ))}
    </div>
    <div class="rd-work-controls" hidden>
      <div class="rd-work-dots" role="group" aria-label="Choose project">
        {projects.map((p, i) => (
          <button class="rd-work-dot" type="button" data-slide={i} aria-label={`Project ${i + 1}: ${p.alt}`} aria-controls={`featured-${p.slug}`} aria-current={i === 0 ? 'true' : 'false'} />
        ))}
      </div>
      <button class="rd-work-play" type="button" aria-label="Pause slideshow" aria-controls="project-slides">
        <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 5v14M17 5v14"/></svg>
        <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5-13-7.5z"/></svg>
      </button>
    </div>
    <p class="rd-work-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('.rd-work-carousel');
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>('.rd-work-track')!;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.rd-work-card'));
    const controls = carousel.querySelector<HTMLElement>('.rd-work-controls')!;
    const dots = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const playButton = controls.querySelector<HTMLButtonElement>('.rd-work-play')!;
    const status = carousel.querySelector<HTMLElement>('.rd-work-status')!;
    const videos = cards.map(card => card.querySelector('video'));
    const failed = new WeakSet<HTMLVideoElement>();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let wantsPlay = !reduced.matches && !connection?.saveData;
    let visible = false, focused = false, scrolling = false;
    let selected = 0, destination = 0, elapsed = 0, lastFrame = 0, frame = 0;
    let settling: ReturnType<typeof setTimeout>;
    let resuming: ReturnType<typeof setTimeout>;
    // 0, not "no delay at all": manual() still needs to run on the next
    // task so wantsPlay's false→true flip doesn't collapse into a no-op
    // within the same call. The other canPlay() gates (scrolling, pointer)
    // already keep playback off for the actual duration of a drag — this
    // was a real, felt wait on top of that, not a deliberate pause.
    const RESUME_DELAY = 0;
    let announce = false;
    let pointer: { id: number; x: number; y: number; scroll: number; mouse: boolean } | null = null;
    let dragged = false;

    const position = (i: number) => cards[i].offsetLeft - (track.clientWidth - cards[i].offsetWidth) / 2;
    // Hovering the media no longer pauses rotation — only an explicit pause,
    // keyboard focus, or an active drag/scroll should stop it.
    const canPlay = () => wantsPlay && visible && !document.hidden && !focused && !scrolling && !pointer;
    function syncPlayback() {
      cancelAnimationFrame(frame);
      lastFrame = 0;
      const playing = canPlay();
      playButton.setAttribute('aria-label', wantsPlay ? 'Pause slideshow' : 'Play slideshow');
      playButton.classList.toggle('is-playing', wantsPlay);
      status.setAttribute('aria-live', wantsPlay ? 'off' : 'polite');
      videos.forEach((video, i) => {
        if (!video) return;
        if (i !== selected || !playing) { video.pause(); return; }
        if (!video.src) { video.src = video.dataset.src!; video.load(); }
        if (!failed.has(video)) video.play().catch((error: DOMException) => {
          // Pausing or switching slides may interrupt a pending play request.
          if (error.name === 'AbortError') return;
          failed.add(video);
          video.classList.remove('is-ready');
        });
      });
      if (playing) frame = requestAnimationFrame(tick);
    }
    function tick(now: number) {
      if (!canPlay()) return;
      elapsed += lastFrame ? Math.min(now - lastFrame, 100) : 0;
      lastFrame = now;
      const video = videos[selected];
      const playable = video && !failed.has(video);
      if (playable && video.readyState < 3 && elapsed > 15000 + video.currentTime * 1000) {
        failed.add(video);
        video.pause();
        video.classList.remove('is-ready');
      }
      const progress = playable && Number.isFinite(video.duration) ? video.currentTime / video.duration : elapsed / 10000;
      dots[selected].style.setProperty('--progress', String(Math.min(1, progress)));
      // A missing or blocked video retains its poster and uses a ten-second slide.
      if ((!playable && elapsed >= 10000) || (playable && video.ended)) {
        go((selected + 1) % cards.length);
        return;
      }
      frame = requestAnimationFrame(tick);
    }
    function select(i: number) {
      if (i !== selected) {
        const previous = videos[selected];
        if (previous) { previous.pause(); previous.currentTime = 0; }
        elapsed = 0;
        dots.forEach(dot => dot.style.setProperty('--progress', '0'));
        // A slide's earlier autoplay failure (a network hiccup, a slow first
        // load) shouldn't blacklist it forever — give it a fresh try each
        // time it comes back around, reloading if the element hard-errored.
        const next = videos[i];
        if (next && failed.has(next)) {
          failed.delete(next);
          if (next.error) next.load();
        }
      }
      selected = destination = i;
      dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === i)));
      if (announce) status.textContent = `Project ${i + 1} of ${cards.length}: ${cards[i].querySelector('h3')!.textContent}`;
      announce = false;
      syncPlayback();
    }
    function settle() {
      scrolling = false;
      const nearest = cards.reduce((best, _, i) => Math.abs(position(i) - track.scrollLeft) < Math.abs(position(best) - track.scrollLeft) ? i : best, 0);
      select(nearest);
    }
    function go(i: number, instant = false) {
      destination = Math.max(0, Math.min(cards.length - 1, i));
      scrolling = true;
      syncPlayback();
      track.scrollTo({ left: position(destination), behavior: instant || reduced.matches ? 'instant' : 'smooth' });
      clearTimeout(settling);
      settling = setTimeout(settle, 180);
    }
    function manual() {
      wantsPlay = false; announce = true; syncPlayback();
      // A swipe/dot-click/arrow-key is "let me drive," not "stop forever" —
      // hand control back to autoplay if nothing else happens for a bit.
      // Repeated manual navigation keeps deferring this while it continues.
      clearTimeout(resuming);
      resuming = setTimeout(() => { wantsPlay = true; syncPlayback(); }, RESUME_DELAY);
    }
    track.addEventListener('scroll', () => {
      if (!scrolling) { scrolling = true; syncPlayback(); }
      clearTimeout(settling);
      settling = setTimeout(settle, 180);
    }, { passive: true });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { manual(); go(i); }));
    playButton.addEventListener('click', () => {
      wantsPlay = !wantsPlay;
      // Explicit play is allowed even while this control holds keyboard focus.
      focused = false;
      // Pressing Play/Pause directly is a final decision, not a "let me
      // drive for a moment" one — it overrides any pending auto-resume from
      // an earlier swipe/dot-click rather than being undone a few seconds later.
      clearTimeout(resuming);
      syncPlayback();
    });
    carousel.addEventListener('keydown', event => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      const targets: Record<string, number> = { ArrowLeft: destination - 1, ArrowRight: destination + 1, Home: 0, End: cards.length - 1 };
      if (!(event.key in targets)) return;
      event.preventDefault(); manual(); go(targets[event.key]);
    });
    carousel.addEventListener('focusin', event => {
      // Keyboard focus pauses rotation; a later explicit Play can resume it.
      if ((event.target as HTMLElement).matches(':focus-visible')) { focused = true; wantsPlay = false; }
      const card = (event.target as HTMLElement).closest<HTMLElement>('.rd-work-card');
      if (card) go(cards.indexOf(card));
      syncPlayback();
    });
    carousel.addEventListener('focusout', event => {
      if (!carousel.contains(event.relatedTarget as Node | null)) { focused = false; syncPlayback(); }
    });
    track.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      dragged = false;
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY, scroll: track.scrollLeft, mouse: event.pointerType === 'mouse' };
    });
    track.addEventListener('pointermove', event => {
      if (!pointer || pointer.id !== event.pointerId) return;
      const dx = event.clientX - pointer.x;
      const dy = event.clientY - pointer.y;
      if (!dragged && Math.hypot(dx, dy) > 8) {
        // Only a real swipe/drag counts as taking manual control. A tap that
        // never moves, or — the common case on touch — a finger that lands on
        // the carousel while the visitor scrolls the page past it, used to
        // stop autoplay permanently with nothing to undo it. A mouse drag is
        // unambiguous, but a touch move is only a deliberate carousel swipe
        // once it's clearly horizontal rather than the page being scrolled.
        if (pointer.mouse || Math.abs(dx) > Math.abs(dy)) { dragged = true; manual(); }
      }
      if (pointer.mouse && dragged) {
        track.setPointerCapture(event.pointerId);
        track.classList.add('is-dragging');
        track.scrollLeft = pointer.scroll - dx;
      }
    });
    const release = () => {
      if (!pointer) return;
      if (track.hasPointerCapture(pointer.id)) track.releasePointerCapture(pointer.id);
      pointer = null;
      track.classList.remove('is-dragging');
      syncPlayback();
    };
    window.addEventListener('pointerup', release);
    window.addEventListener('pointercancel', release);
    track.addEventListener('click', event => {
      if (dragged && event.detail !== 0) { event.preventDefault(); event.stopPropagation(); }
    }, true);
    // A trackpad's vertical scroll commonly carries tiny stray deltaX noise;
    // only a horizontal-dominant wheel gesture is a deliberate carousel nudge.
    track.addEventListener('wheel', event => { if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) manual(); }, { passive: true });
    videos.forEach(video => {
      if (!video) return;
      video.muted = true;
      video.addEventListener('loadeddata', () => video.classList.add('is-ready'));
      video.addEventListener('error', () => { failed.add(video); video.classList.remove('is-ready'); });
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting && entry.intersectionRatio >= 0.35;
      syncPlayback();
    }, { threshold: [0, 0.35] }).observe(track);
    document.addEventListener('visibilitychange', syncPlayback);
    reduced.addEventListener('change', () => { if (reduced.matches) wantsPlay = false; syncPlayback(); });
    new ResizeObserver(() => go(selected, true)).observe(track);
    controls.hidden = false;
    carousel.classList.add('is-enhanced');
    syncPlayback();
  }
</script>
