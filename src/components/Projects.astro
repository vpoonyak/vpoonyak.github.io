---

<section class="rd-work" id="projects">
  <div class="rd-section-head">
    <div class="rd-section-num">03</div>
    <h2 class="rd-section-kicker">Projects</h2>
    <a href="/project/" class="rd-btn rd-section-action">Full project archive / 13 ↗︎</a>
  </div>

  {/* Two visibility tiers, both driven by how many columns the grid can open,
      so a row is never left with holes:
        `is-extra`      — cards 4-6, dropped in the single-column layout where
                          six cards cost about three screens of thumb-scrolling.
        `is-wide-extra` — cards 7-8, added only at four columns.
      The section header links the full archive, so nothing hidden becomes
      unreachable. All eight are rendered and hidden in CSS rather than sliced
      out, so the markup a crawler sees does not depend on viewport width. */}
  <div class="rd-work-grid">
    {projects.map((p, i) => (
      <a href={`/project/${p.slug}/`} class:list={['rd-work-card', i >= 3 && i < 6 && 'is-extra', i >= 6 && 'is-wide-extra']}>
        <div class="rd-work-meta">
          <span>{p.kicker}</span>
          <span class="arrow">↗︎</span>
        </div>
        <img src={p.thumb} alt={p.alt} width="600" height="210" loading="lazy">
        <div class="rd-work-title" set:html={p.title} />
        <div class="rd-work-desc">{p.desc}</div>
      </a>
    ))}
  </div>
</section>
