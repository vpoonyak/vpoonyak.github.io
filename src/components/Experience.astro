---
// Dates mirror Vitchakorn_Poonyakanok_CV.tex in the separate ~/Github/cv
// repo. Both MOPH entries run Nov 2024 -- Jul 2026 there (academic leave
// from Aug 2026 for the MSHCA), so neither is narrowed to a single year.
const clinical = [
  {
    year: '2024 — 2026',
    logos: [
      { src: '/experience/ipm.webp', alt: 'Institute of Preventive Medicine' },
      { src: '/experience/moph.webp', alt: 'Ministry of Public Health' },
    ],
    role: 'Travel Medicine Resident',
    org: 'Institute of Preventive Medicine, DDC, MOPH',
    note: 'On academic leave from Aug 2026; residency resumes on return.',
  },
  {
    year: '2024 — 2026',
    logos: [
      { src: '/experience/pty.webp', alt: 'Pattayarak Health Unit' },
      { src: '/experience/moph.webp', alt: 'Ministry of Public Health' },
    ],
    role: 'Medical Physician, Professional Level (Preventive &amp; Travel Medicine)',
    org: 'Office of Disease Prevention and Control 6 (ODPC 6), DDC, MOPH',
    note: 'Travel consultations and vaccination; site physician for WHO EGASP surveillance.',
  },
  {
    year: '2022 — 2024',
    logos: [
      { src: '/experience/bidi.webp', alt: 'Bamrasnaradura Infectious Diseases Institute' },
      { src: '/experience/moph.webp', alt: 'Ministry of Public Health' },
    ],
    role: 'General Practitioner',
    org: 'Bamrasnaradura Infectious Diseases Institute',
    note: 'Led outpatient and ARI clinics; analysed 32,084 visits in Python to identify scheduling bottlenecks.',
  },
  {
    year: '2020 — 2022',
    logos: [
      { src: '/experience/sskh.webp', alt: 'Si Songkhram Hospital' },
      { src: '/experience/moph.webp', alt: 'Ministry of Public Health' },
    ],
    role: 'General Practitioner (Intern)',
    org: 'Si Songkhram Hospital',
  },
  {
    year: '2019 — 2020',
    logos: [
      { src: '/experience/nkh.webp', alt: 'Nong Khai Hospital' },
      { src: '/experience/moph.webp', alt: 'Ministry of Public Health' },
    ],
    role: 'General Practitioner (Intern)',
    org: 'Nong Khai Hospital',
  },
];

const education = [
  {
    year: 'AUG 2026 — MAY 2028',
    current: true,
    logos: [
      { src: '/experience/cmu.webp', alt: 'Carnegie Mellon University' },
      { src: '/experience/carnegie_mellon_university___h_john_heinz_iii_college_logo.jpeg', alt: 'Heinz College' },
    ],
    role: 'M.S. Health Care Analytics &amp; IT (MSHCA)',
    org: 'Carnegie Mellon University, Heinz College',
    note: 'Royal Thai Government (DDC) scholarship. Health system analytics, data governance, and information systems.',
  },
  {
    year: '2025 — 2026',
    logos: [
      { src: '/experience/chula.webp', alt: 'Chulalongkorn University' },
      { src: '/experience/digihealth-dh.png', alt: 'DigiHealth' },
    ],
    role: 'Master of Science in Digital and AI Technologies in Health Systems (DigiHealth)',
    org: 'Chulalongkorn University (DigiHealth)',
    note: 'Independent study: AI-assisted altitude extraction from travel itineraries, the work behind altit.app.',
  },
  {
    year: '2013 — 2019',
    logos: [{ src: '/experience/rama.webp', alt: 'Ramathibodi Hospital' }],
    role: 'Doctor of Medicine (MD)',
    org: 'Mahidol University (Ramathibodi Hospital)',
  },
  {
    year: '2010 — 2013',
    logos: [{ src: '/experience/tu.webp', alt: 'Triam Udom Suksa School' }],
    role: 'High School',
    org: 'Triam Udom Suksa School',
  },
];
---

<section class="rd-section" id="experience">
  <div class="rd-section-head">
    <div class="rd-section-num">02</div>
    <h2 class="rd-section-kicker">Experience</h2>
  </div>

  <div class="rd-split">
    <div>
      <div class="rd-col-label">Clinical &amp; Research</div>
      <div class="rd-tl">
        {clinical.slice(0, 3).map((item) => (
          <div class="rd-tl-item">
            <div class="rd-tl-year">{item.year}</div>
            <div class="rd-tl-row">
              <div class="rd-tl-logos">
                {item.logos.map((l) => <img src={l.src} alt={l.alt} width="38" height="38" loading="lazy">)}
              </div>
              <div>
                <div class="rd-tl-role" set:html={item.role} />
                <div class="rd-tl-org">{item.org}</div>
                {item.note && <div class="rd-tl-note">{item.note}</div>}
              </div>
            </div>
          </div>
        ))}
        <details class="rd-mobile-details" data-mobile-detail open>
          <summary>Earlier clinical roles</summary>
          <div class="rd-tl">
        {clinical.slice(3).map((item) => (
          <div class="rd-tl-item">
            <div class="rd-tl-year">{item.year}</div>
            <div class="rd-tl-row">
              <div class="rd-tl-logos">
                {item.logos.map((l) => <img src={l.src} alt={l.alt} width="38" height="38" loading="lazy">)}
              </div>
              <div>
                <div class="rd-tl-role" set:html={item.role} />
                <div class="rd-tl-org">{item.org}</div>
                {item.note && <div class="rd-tl-note">{item.note}</div>}
              </div>
            </div>
          </div>
        ))}
          </div>
        </details>
      </div>
    </div>

    <div>
      <div class="rd-col-label">Education</div>
      <div class="rd-tl">
        {education.slice(0, 3).map((item) => (
          <div class="rd-tl-item">
            <div class="rd-tl-year">{item.year}</div>
            <div class="rd-tl-row">
              <div class="rd-tl-logos">
                {item.logos.map((l) => <img src={l.src} alt={l.alt} width="38" height="38" loading="lazy">)}
              </div>
              <div>
                <div class="rd-tl-role">
                  <span set:html={item.role} />
                  {item.current && <span class="rd-chip-current">CURRENT</span>}
                </div>
                <div class="rd-tl-org">{item.org}</div>
                {item.note && <div class="rd-tl-note">{item.note}</div>}
              </div>
            </div>
          </div>
        ))}
        <details class="rd-mobile-details" data-mobile-detail open>
          <summary>Earlier education</summary>
          <div class="rd-tl">
        {education.slice(3).map((item) => (
          <div class="rd-tl-item">
            <div class="rd-tl-year">{item.year}</div>
            <div class="rd-tl-row">
              <div class="rd-tl-logos">
                {item.logos.map((l) => <img src={l.src} alt={l.alt} width="38" height="38" loading="lazy">)}
              </div>
              <div>
                <div class="rd-tl-role">
                  <span set:html={item.role} />
                  {item.current && <span class="rd-chip-current">CURRENT</span>}
                </div>
                <div class="rd-tl-org">{item.org}</div>
                {item.note && <div class="rd-tl-note">{item.note}</div>}
              </div>
            </div>
          </div>
        ))}
          </div>
        </details>
      </div>
    </div>
  </div>
</section>
