---
// Standing ask, pinned bottom-right. Dismissible, and the dismissal sticks
// for the session so it doesn't nag a returning reader mid-page.
//
// On phones this sits in the hero's normal flow, before the stats, so it
// cannot cover page content. Desktop retains a quieter floating invitation.
---

<div class="rd-float-cta" id="floatCta">
  <button type="button" class="rd-float-cta-close" id="floatCtaClose" aria-label="Dismiss Summer 2027 internship search invitation">✕</button>
  <div class="cta-copy">
    <span class="cta-title">Seeking a Summer 2027 internship</span>
    <span class="cta-meta">Health care analytics · USA · May 11 – Aug 20 · 300+ hours</span>
  </div>
  <a class="cta-action"
    href="/host-org-one-pager.pdf"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Seeking a Summer 2027 health care analytics internship, United States -- view internship brief, PDF"
  >
    View brief
  </a>
</div>

<script>
  const cta = document.getElementById('floatCta');
  const close = document.getElementById('floatCtaClose');
  try {
    if (sessionStorage.getItem('vp-cta-dismissed') === '1') cta?.classList.add('is-dismissed');
  } catch { /* The invitation still works when storage is unavailable. */ }
  close?.addEventListener('click', () => {
    cta?.classList.add('is-dismissed');
    try { sessionStorage.setItem('vp-cta-dismissed', '1'); } catch { /* Dismiss for this page. */ }
  });
  // Keep the card clear of the contact form's controls and the footer below
  // it. Watching #contact alone left a gap: on a short viewport the section
  // can scroll fully out of view (un-hiding the card) while the footer is
  // still on screen, right where the card would then land. Hiding on either
  // intersecting covers both, since nothing follows the footer to scroll to.
  const contact = document.getElementById('contact');
  const footer = document.querySelector('.rd-footer');
  let overContact = false, overFooter = false;
  const syncOverContact = () => cta?.classList.toggle('is-over-contact', overContact || overFooter);
  if (contact) new IntersectionObserver(([entry]) => { overContact = entry.isIntersecting; syncOverContact(); }).observe(contact);
  if (footer) new IntersectionObserver(([entry]) => { overFooter = entry.isIntersecting; syncOverContact(); }).observe(footer);
  const projects = document.getElementById('projects');
  if (projects) new IntersectionObserver(([entry]) => {
    cta?.classList.toggle('is-over-projects', entry.isIntersecting);
  }).observe(projects);
</script>
