---
interface Props {
  // Minimal single-row bar for content-reading pages (e.g. a blog post):
  // brand, a "back" link, and the theme toggle only — no section links.
  compact?: boolean;
  backHref?: string;
  backLabel?: string;
  // Omit the "Blog" item from the mobile dropdown — for the /blog listing
  // page itself, where a link to itself is redundant.
  hideBlogLink?: boolean;
  // Compact-nav only: a globe link to a blog post's other-language
  // translation. Undefined on every page except a post that has one.
  translationHref?: string;
  translationLabel?: string;
  translationTitle?: string;
}

const {
  compact = false,
  backHref = '/blog',
  backLabel = 'Blog',
  hideBlogLink = false,
  translationHref,
  translationLabel,
  translationTitle,
} = Astro.props;

// Section anchors only mean anything on the homepage -- every other page
// gets page links instead, so nothing in the bar points at a fragment that
// doesn't exist on the current document.
const isHome = Astro.url.pathname === '/';

// Inline bar links: five, so the row still fits without scrolling at laptop
// widths. The dropdown carries the full section list.
// #publications is headed "Research & Awards" on the page; the bar and the
// dropdown shorten it to "Research" -- the full label is ~50px wider in the
// uppercase bar face and would push the collapse breakpoint out for no gain.
const barSections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'publications', label: 'Research' },
  { id: 'contact', label: 'Contact' },
];

const menuSections = [
  ...barSections.slice(0, 4),
  { id: 'training', label: 'Training' },
  { id: 'skills', label: 'Capabilities' },
  { id: 'contact', label: 'Contact' },
];

// The archive and the blog both live in the fixed tail of the bar, so these
// are only the page links that vary by context.
const barLinks = [
  { href: '/#top', label: 'Home' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class:list={['rd-nav', compact && 'is-compact']} id="topNav">
  <a href="/#top" class="rd-nav-brand" aria-label="Back to top">
    <span class="rd-nav-dot"></span>
    <span class="rd-nav-name">Vitchakorn</span>
    <span class="rd-nav-nick">&ldquo;Blue&rdquo;</span>
  </a>

  {compact && <a href={backHref} class="rd-nav-item is-back">← {backLabel}</a>}
  {!compact && isHome && barSections.map((s) => (
    <a href={`#${s.id}`} class="rd-nav-item" data-navsec={s.id}>{s.label}</a>
  ))}
  {!compact && !isHome && barLinks.map((l) => (
    <a href={l.href} class="rd-nav-item">{l.label}</a>
  ))}

  <button type="button" id="menuBtn" class="rd-nav-btn rd-nav-menu" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
    <span class="rd-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    <span id="menuBtnLabel">Menu</span>
  </button>

  {translationHref && (
    <a href={translationHref} class="rd-nav-btn rd-nav-lang" title={translationTitle}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>{translationLabel}
    </a>
  )}

  <button id="themeToggle" class="rd-nav-btn rd-nav-theme" aria-label="Toggle theme">
    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>

  <a href="/project/" class="rd-nav-cta is-secondary">Archive ↗︎</a>
  <a href="/blog" class="rd-nav-cta">Blog ↗︎</a>
</nav>

<div class="rd-nav-spacer" id="navSpacer"></div>

<div class="rd-mobile-menu" id="mobileMenu" aria-hidden="true" inert>
  <a href="/#top">Home</a>
  {isHome && menuSections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
  <a href="/project/">Project Archive</a>
  {!hideBlogLink && <a href="/blog">Blog</a>}
  {!isHome && <a href="/contact">Contact</a>}
</div>

<style>
  /* Fixed single-row bar. It scrolls horizontally rather than wrapping, so
     the 2px baseline rule under it stays one unbroken line at every width. */
  .rd-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    align-items: stretch;
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .rd-nav::-webkit-scrollbar { display: none; }
  .rd-nav a { color: inherit; text-decoration: none; }

  /* min-width: max-content is load-bearing. The bar is nowrap, so a cell
     allowed to shrink past its text doesn't wrap -- it lets the text bleed
     under the next cell. Every cell floors at its content width and the bar
     scrolls horizontally instead. */
  .rd-nav-brand {
    flex: 2 1 auto;
    min-width: max-content;
    padding: 14px 20px;
    border-right: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .rd-nav-brand:hover { color: var(--accent); }
  .rd-nav-dot { width: 9px; height: 9px; background: var(--accent); display: inline-block; flex: none; }
  .rd-nav-name { font-family: inherit; font-weight: 600; }
  .rd-nav-nick { font-style: italic; text-transform: none; font-weight: 400; color: var(--muted); }

  .rd-nav-item {
    flex: 1 1 auto;
    min-width: max-content;
    padding: 14px 16px;
    border-right: none;
    display: flex;
    align-items: center;
  }
  .rd-nav-item:hover { color: var(--accent); }
  .rd-nav-item.is-active { color: var(--accent); }
  .rd-nav-item.is-back { flex: 2; text-transform: none; }

  .rd-nav-btn {
    flex: none;
    padding: 14px 16px;
    border: none;
    border-right: none;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .rd-nav-btn:hover { color: var(--accent); }
  .rd-nav-theme { background: transparent; position: relative; min-width: 48px; min-height: 44px; }
  .rd-nav-lang { text-transform: none; font-family: 'JetBrains Mono', monospace; font-size: 12px; }
  .rd-nav-menu { display: none; }
  .rd-nav-menu { min-height: 44px; gap: 9px; }
  #menuBtnLabel { min-width: 3em; text-align: left; }
  .rd-menu-icon { display: block; position: relative; width: 18px; height: 16px; flex: none; }
  .rd-menu-icon span {
    position: absolute; left: 0; width: 18px; height: 2px;
    background: currentColor; border-radius: 2px;
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease;
  }
  .rd-menu-icon span:nth-child(1) { top: 1px; }
  .rd-menu-icon span:nth-child(2) { top: 7px; }
  .rd-menu-icon span:nth-child(3) { top: 13px; }
  .rd-nav-menu[aria-expanded="true"] .rd-menu-icon span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .rd-nav-menu[aria-expanded="true"] .rd-menu-icon span:nth-child(2) { transform: scaleX(0); opacity: 0; }
  .rd-nav-menu[aria-expanded="true"] .rd-menu-icon span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .rd-nav-cta {
    flex: none;
    padding: 14px 24px;
    background: transparent;
    color: var(--ink);
    display: flex;
    align-items: center;
  }
  .rd-nav-cta:hover { color: var(--accent); background: var(--chip); }

  /* Second destination beside Blog. Outlined rather than filled so the bar
     keeps a single accent block instead of two competing ones. */
  .rd-nav-cta.is-secondary { background: var(--bg); color: var(--ink); }
  .rd-nav-cta.is-secondary:hover { background: var(--chip); color: var(--accent); }

  .rd-nav-spacer { height: var(--nav-h); }

  .rd-mobile-menu {
    position: fixed;
    top: var(--nav-h); left: 0; right: 0;
    z-index: 99;
    display: flex;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
    transition: opacity 180ms ease, transform 260ms cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 260ms;
    flex-direction: column;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    max-height: calc(100vh - var(--nav-h));
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .rd-mobile-menu.is-open { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); transition-delay: 0s; }
  .rd-mobile-menu a { padding: 14px 24px; border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none; }
  .rd-mobile-menu a:last-child { border-bottom: none; }
  .rd-mobile-menu a:hover { color: var(--accent); }

  /* Sun/moon swap is driven by the theme attribute, not JS class toggling. */
  .rd-nav-theme .icon-sun, .rd-nav-theme .icon-moon { display: block; }
  .icon-sun, .icon-moon {
    position: absolute; left: 50%; top: 50%;
    opacity: 0; transform: translate(-50%, -50%) rotate(-40deg) scale(0.7);
    transition: opacity 180ms ease, transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .icon-moon, :global([data-theme="dark"]) .icon-sun { opacity: 1; transform: translate(-50%, -50%) rotate(0) scale(1); }
  :global([data-theme="dark"]) .icon-moon { opacity: 0; transform: translate(-50%, -50%) rotate(40deg) scale(0.7); }
  .rd-nav a, .rd-nav-btn, .rd-mobile-menu a { transition: color 160ms ease, background-color 160ms ease; }
  @media (prefers-reduced-motion: reduce) {
    .rd-menu-icon span, .rd-mobile-menu, .icon-sun, .icon-moon,
    .rd-nav a, .rd-nav-btn, .rd-mobile-menu a { transition: none; }
    .rd-mobile-menu { transform: none; }
  }

  /* The full bar (brand + five section links + Archive + Blog) needs about
     1080px. Below that the section links collapse into the dropdown rather
     than letting the bar scroll and push Blog off-screen. */
  @media (max-width: 1080px) {
    .rd-nav-item:not(.is-back) { display: none; }
    .rd-nav-menu { display: flex; }
  }

  @media (max-width: 860px) {
    /* Decorative, and the first thing to go when space is tight. */
    .rd-nav-nick { display: none; }
  }

  /* The wordmark must never truncate. Once the tail (Menu + theme + two
     CTAs) stops leaving room for it, drop the Archive button — "Project
     Archive" is already the third item in the dropdown, so nothing is
     lost — and stop the brand cell from compressing below its content. */
  @media (max-width: 700px) {
    .rd-nav-cta.is-secondary { display: none; }
  }

  @media (max-width: 400px) {
    .rd-nav { font-size: 12px; }
    .rd-nav-brand { padding: 14px 14px; }
    .rd-nav-cta { padding: 14px 16px; }
  }
  .rd-nav.is-compact .rd-nav-menu { display: flex; }
</style>

<script>
  const nav = document.getElementById('topNav');
  const spacer = document.getElementById('navSpacer');
  const menuBtn = document.getElementById('menuBtn');
  const menuBtnLabel = document.getElementById('menuBtnLabel');
  const mobileMenu = document.getElementById('mobileMenu');

  // The bar is fixed, so the spacer below it has to track its real height
  // (which changes when the font loads or the viewport narrows).
  function fitNav() {
    if (!nav) return;
    const h = nav.offsetHeight;
    document.documentElement.style.setProperty('--nav-h', h + 'px');
    if (spacer) spacer.style.height = h + 'px';
  }
  fitNav();
  window.addEventListener('resize', fitNav);
  window.addEventListener('load', fitNav);
  if (document.fonts?.ready) document.fonts.ready.then(fitNav);

  if (menuBtn && mobileMenu) {
    function setMenu(open: boolean, returnFocus = false) {
      mobileMenu!.classList.toggle('is-open', open);
      mobileMenu!.inert = !open;
      mobileMenu!.setAttribute('aria-hidden', String(!open));
      menuBtn!.setAttribute('aria-expanded', String(open));
      menuBtn!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (menuBtnLabel) menuBtnLabel.textContent = open ? 'Close' : 'Menu';
      if (returnFocus) {
        if (getComputedStyle(menuBtn!).display !== 'none') menuBtn!.focus();
        else nav?.querySelector('a')?.focus();
      }
    }
    menuBtn.addEventListener('click', () => {
      setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
    });
    mobileMenu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        setMenu(false, true);
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        event.preventDefault(); setMenu(false, true);
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !nav?.contains(event.target) && !mobileMenu.contains(event.target)) {
        setMenu(false, mobileMenu.contains(document.activeElement));
      }
    });
    window.addEventListener('resize', () => {
      if (getComputedStyle(menuBtn).display === 'none') setMenu(false, mobileMenu.contains(document.activeElement));
    });
  }
</script>
