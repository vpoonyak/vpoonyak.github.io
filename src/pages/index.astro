---
import '../styles/redesign.css';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import SectionRail from '../components/SectionRail.astro';
import Hero from '../components/Hero.astro';
import Roles3D from '../components/Roles3D.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Publications from '../components/Publications.astro';
import Training from '../components/Training.astro';
import Capabilities from '../components/Capabilities.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout isHome={true}>
  <Navigation />
  <SectionRail />
  <main id="main">
    <Hero />
    <Roles3D />
    <About />
    <Experience />
    <Projects />
    <Publications />
    <Training />
    <Capabilities />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  // Supporting details start closed on phones, with native keyboard and
  // screen-reader disclosure controls. Without JavaScript all content stays open.
  const mobileDetails = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-mobile-detail]'));
  const mobileView = window.matchMedia('(max-width: 760px)');
  const fitDetails = () => mobileDetails.forEach(detail => { detail.open = !mobileView.matches; });
  mobileView.addEventListener('change', fitDetails);
  fitDetails();
  // Direct links into a disclosure must still reveal their destination.
  function revealDestination() {
    let target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    while (target) {
      if (target instanceof HTMLDetailsElement) target.open = true;
      target = target.parentElement;
    }
  }
  window.addEventListener('hashchange', revealDestination);
  revealDestination();
  // ── Hero parallax ──
  // Elements tagged data-sp drift against the scroll by that factor. Purely
  // decorative, so reduced-motion visitors get the static layout.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const parallax = Array.from(document.querySelectorAll<HTMLElement>('[data-sp]'));

  if (!reduce && parallax.length) {
    let ticking = false;
    function apply() {
      const vh = window.innerHeight;
      for (const el of parallax) {
        const r = el.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) continue;
        const d = parseFloat(el.dataset.sp || '0');
        el.style.translate = `0 ${((r.top + r.height / 2 - vh / 2) * -d).toFixed(1)}px`;
      }
    }
    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        apply();
      });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    apply();
  }

  // ── Scroll reveal ──
  const revealTargets = document.querySelectorAll('.rd-reveal');
  if (revealTargets.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );
    revealTargets.forEach((el) => io.observe(el));
  }
</script>
